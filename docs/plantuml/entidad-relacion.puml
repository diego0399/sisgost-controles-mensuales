@startuml entidad-relacion
title SISGOST — Controles Mensuales · Modelo entidad-relación
hide circle
skinparam linetype ortho

entity DIRECCION {
  * id : texto <<PK>>
  --
  nombre
  corta
  unidades[]
  activa
}

entity USUARIO_SISTEMA <<compartida>> {
  * usuario : texto <<PK>>
  --
  nombre
  rol / clave
  cargo, unidad, estado
  moduloControles
}

entity DISTRIBUCION_SOPORTE <<compartida>> {
  * id <<PK>>
  --
  direccion, unidad
  tecnico  <<FK usuario>>
  asignadoPor, fecha, hora
  activo
  desactivadaPor?, fechaDesactivacion?
  observacion
}

entity FERIADO {
  * fecha + nombre <<PK>>
  --
  ambito (Nacional / San Salvador)
}

entity CONTROL_CATALOGO {
  * codigo <<PK>>
  --
  nombre, version
  frecuencia
  aplicacion (modo, direcciones,
    unidades, area, observaciones)
  requiereEvidencia
  requiereFirma
  permiteJustificacion
  plantilla (secciones)
}

entity AREA_TECNICA {
  * id <<PK>>
  --
  nombre, descripcion
  pares Dirección/Unidad
}

entity CONTROL_MES {
  * id <<PK>>
  --
  codigo <<FK>>
  anio, mes, semana?
  direccion <<FK>>
  responsable
  estado
  fechaLimite
  fechaEntrega?
  avance
  secciones (respuestas)
  equipos revisados[]
  evidencias[]
}

entity BITACORA_DIARIA {
  * id <<PK>>
  --
  fecha
  direccion <<FK>>
  responsable
  estado
  horaEnvio?
  revision[9]
  actividades[]
}

entity JUSTIFICACION {
  * id <<PK>>
  --
  codigoControl <<FK>>
  anio, mes
  direccion <<FK>>
  motivo, texto
  estado
  firmas[3]
}

entity EQUIPO_OPERATIVO <<compartida>> {
  * ciclo <<PK>>
  --
  inventario
  --
  tipo, marca, modelo, serie
  usuarioFinal
  direccion <<FK>>, unidad
  soporteResponsable
  fechaAceptacion
  expediente, expedienteUnico
  estado
  garantia
  origen
}

entity EVENTO_INTEGRACION {
  * id <<PK>>
  --
  tipo (entrega / descargo)
  moduloOrigen, moduloDestino
  expediente, expedienteUnico
  detalle
  equipo
  aplicado
}

entity DOCUMENTO_GENERADO {
  * id <<PK>>
  --
  tipo
  nombre, codigo
  fecha, hora
  direccion, mes, anio
  hash
  referencia <<FK polimórfica>>
}

entity EVENTO_TRAZABILIDAD {
  * id <<PK>>
  --
  fecha, hora
  usuario, rol
  accion
  estadoAnterior / estadoNuevo
  moduloOrigen / moduloDestino
  inventario?
  documento?
}

DIRECCION ||--o{ DISTRIBUCION_SOPORTE
USUARIO_SISTEMA ||--o{ DISTRIBUCION_SOPORTE
DIRECCION ||--o{ CONTROL_MES
CONTROL_CATALOGO ||--o{ CONTROL_MES
AREA_TECNICA |o--o{ CONTROL_CATALOGO : "aplica a (modo área técnica)"
DIRECCION ||--o{ BITACORA_DIARIA
DIRECCION ||--o{ EQUIPO_OPERATIVO
CONTROL_MES |o--o| JUSTIFICACION
CONTROL_MES |o--o| DOCUMENTO_GENERADO
BITACORA_DIARIA |o--o| DOCUMENTO_GENERADO
JUSTIFICACION |o--o| DOCUMENTO_GENERADO
EVENTO_INTEGRACION }o--|| EQUIPO_OPERATIVO : actualiza
EQUIPO_OPERATIVO }o--o{ CONTROL_MES : "revisado en\n(RespuestaEquipo)"
DISTRIBUCION_SOPORTE .. CONTROL_MES : "define el responsable"
FERIADO .. CONTROL_MES : "define los días hábiles\nde la fecha límite"
DOCUMENTO_GENERADO ||--o{ EVENTO_TRAZABILIDAD
@enduml
